{
  "name": "evote-booth",
  "productName": "Campus E-Voting Booth",
  "version": "1.0.0",
  "description": "Full-screen voting booth app: setup screen, locked to the portal, silent printing, officer-code exit",
  "main": "main.js",
  "author": "Campus E-Voting",
  "license": "MIT",
  "homepage": "https://github.com/s0n4jit/e-voting",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "edu.campus.evote.booth",
    "productName": "Campus E-Voting Booth",
    "files": [
      "main.js",
      "preload-page.js",
      "preload-ui.js",
      "lib/**",
      "ui/**",
      "bin/**",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "Campus-E-Voting-Booth-Setup.${ext}"
    },
    "appImage": {
      "artifactName": "Campus-E-Voting-Booth.${ext}"
    },
    "deb": {
      "artifactName": "evote-booth_${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Campus E-Voting <noreply@example.com>",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "s0n4jit",
        "repo": "e-voting"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
