[Unit]
Description=Campus E-Voting booth (Cage + Firefox kiosk)
After=systemd-user-sessions.service systemd-logind.service live-config.service network-online.target getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStartPre=+/usr/local/bin/evote-booth-prepare
ExecStart=/usr/local/bin/evote-booth-session
User=evote
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=WLR_NO_HARDWARE_CURSORS=1
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
