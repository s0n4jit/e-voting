#!/bin/bash
# Runs as root before the booth starts: reads the portal address from the kernel command line,
# writes the browser policy that allows only that address, and hardens the booth account.
set -euo pipefail

CMDLINE_FILE="${CMDLINE_FILE:-/proc/cmdline}"
OUT_DIR="${OUT_DIR:-/run/evote}"
BASE_POLICY="${BASE_POLICY:-/usr/share/evote/policies.base.json}"
SETUP_PAGE="http://127.0.0.1:9631/setup"
mkdir -p /etc/evote
POLICY_DIRS=(${POLICY_DIRS:-/etc/firefox/policies /usr/lib/firefox-esr/distribution})

# A disk or stick labelled EVOTE-DATA keeps the receipts and the booth settings across restarts.
if [[ -z "${EVOTE_SKIP_DATA:-}" ]] && dev="$(blkid -L EVOTE-DATA 2>/dev/null)" && [[ -n "${dev}" ]]; then
    mkdir -p /var/lib/evote
    mountpoint -q /var/lib/evote || mount "${dev}" /var/lib/evote || true
    mkdir -p /var/lib/evote/receipts /etc/evote
    chmod 700 /var/lib/evote/receipts
    [[ -f /var/lib/evote/booth.conf ]] || cp -n /etc/evote/booth.conf /var/lib/evote/booth.conf 2>/dev/null || true
    [[ -f /var/lib/evote/booth.conf ]] && ln -sf /var/lib/evote/booth.conf /etc/evote/booth.conf
fi

url=""
for word in $(cat "${CMDLINE_FILE}"); do
    case "${word}" in evote.url=*) url="${word#evote.url=}" ;; esac
done
# an address saved with `evote url set` or the setup page wins over the one embedded in the image
saved="$(sed -n 's/^VOTING_URL="\(.*\)"$/\1/p' /etc/evote/booth.conf 2>/dev/null | head -1)"
[[ -n "${saved}" ]] && url="${saved}"

if [[ "${url}" =~ ^https?://[^/[:space:]]+/kiosk/vote$ ]]; then
    allowed="${url}*"
else
    url="${SETUP_PAGE}"                 # no (or an invalid) address: the first-boot setup page
    allowed="http://127.0.0.1:9631/setup*"
    touch /etc/evote/setup-pending      # switches the agent's setup mode on
fi

mkdir -p "${OUT_DIR}"
printf '%s\n' "${url}" > "${OUT_DIR}/url"
chmod 755 "${OUT_DIR}"; chmod 644 "${OUT_DIR}/url"

for dir in "${POLICY_DIRS[@]}"; do
    mkdir -p "${dir}"
    python3 - "${BASE_POLICY}" "${dir}/policies.json" "${allowed}" <<'PYEOF'
import json, re, sys
base, out, allowed = sys.argv[1:4]
allowed = re.sub(r"^(https?://[^/:]+):\d+", r"\1", allowed)  # Firefox match patterns have no port
policy = json.load(open(base))
p = policy["policies"]
agent = "http://127.0.0.1:9631/*"  # the booth agent on this machine (printing)
p["WebsiteFilter"]["Exceptions"] = [allowed, agent]
p["URLAllowlist"] = [allowed, agent]
json.dump(policy, open(out, "w"), indent=2)
PYEOF
    chmod 644 "${dir}/policies.json"
done

# The booth account has no password and no administrative groups.
if id evote >/dev/null 2>&1 && [[ -z "${EVOTE_SKIP_ACCOUNT:-}" ]]; then
    passwd -l evote >/dev/null 2>&1 || true
    usermod -G video,render,input evote 2>/dev/null || true
fi
