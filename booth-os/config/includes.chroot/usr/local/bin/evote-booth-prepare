#!/bin/bash
# Runs as root before the booth starts: reads the portal address from the kernel command line,
# writes the browser policy that allows only that address, and hardens the booth account.
set -euo pipefail

CMDLINE_FILE="${CMDLINE_FILE:-/proc/cmdline}"
OUT_DIR="${OUT_DIR:-/run/evote}"
BASE_POLICY="${BASE_POLICY:-/usr/share/evote/policies.base.json}"
SETUP_PAGE="file:///usr/share/evote/setup.html"
POLICY_DIRS=(${POLICY_DIRS:-/etc/firefox/policies /usr/lib/firefox-esr/distribution})

url=""
for word in $(cat "${CMDLINE_FILE}"); do
    case "${word}" in evote.url=*) url="${word#evote.url=}" ;; esac
done

if [[ "${url}" =~ ^https?://[^/[:space:]]+/kiosk/vote$ ]]; then
    allowed="${url}*"
else
    url="${SETUP_PAGE}"                 # no (or an invalid) address was embedded: show how to set one
    allowed="file:///usr/share/evote/*"
fi

mkdir -p "${OUT_DIR}"
printf '%s\n' "${url}" > "${OUT_DIR}/url"
chmod 755 "${OUT_DIR}"; chmod 644 "${OUT_DIR}/url"

for dir in "${POLICY_DIRS[@]}"; do
    mkdir -p "${dir}"
    python3 - "${BASE_POLICY}" "${dir}/policies.json" "${allowed}" <<'PYEOF'
import json, sys
base, out, allowed = sys.argv[1:4]
policy = json.load(open(base))
p = policy["policies"]
p["WebsiteFilter"]["Exceptions"] = [allowed]
p["URLAllowlist"] = [allowed]
json.dump(policy, open(out, "w"), indent=2)
PYEOF
    chmod 644 "${dir}/policies.json"
done

# The booth account has no password and no administrative groups.
if id evote >/dev/null 2>&1 && [[ -z "${EVOTE_SKIP_ACCOUNT:-}" ]]; then
    passwd -l evote >/dev/null 2>&1 || true
    usermod -G video,render,input evote 2>/dev/null || true
fi
