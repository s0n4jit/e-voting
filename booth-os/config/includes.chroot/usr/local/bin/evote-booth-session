#!/bin/bash
# Starts the single-window desktop (cage) with the booth browser. Real GPUs use their normal path; if that
# fails at once (virtual machines, unusual graphics), it retries with software drawing.
start=$(date +%s)
/usr/bin/cage -- /usr/local/bin/evote-booth-browser && exit 0
if (( $(date +%s) - start < 20 )); then
    export WLR_RENDERER=pixman WLR_RENDERER_ALLOW_SOFTWARE=1
    exec /usr/bin/cage -- /usr/local/bin/evote-booth-browser
fi
exit 1
