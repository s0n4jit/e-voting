#!/bin/sh
# Final touches inside the image: services on, text consoles and key combinations off.
set -e
chmod 644 /etc/systemd/logind.conf.d/evote.conf /etc/modprobe.d/evote-block-storage.conf /etc/sysctl.d/90-evote.conf /etc/systemd/system/evote-booth.service /usr/share/evote/* /etc/initramfs-tools/modules
# The booth account: no password, no shell, only what the display needs.
id evote >/dev/null 2>&1 || useradd -m -s /usr/sbin/nologin -G video,render,input evote
passwd -l evote
systemctl enable evote-booth.service NetworkManager systemd-timesyncd
systemctl set-default graphical.target
# maintenance login on tty2 (Ctrl+Alt+F2): user "evoteadmin", locked until a password is set in the setup page,
# and its only shell is the evote command prompt (reboot, restart browser, network, printer, receipts).
echo /usr/local/bin/evote-shell >> /etc/shells
id evoteadmin >/dev/null 2>&1 || useradd -m -s /usr/local/bin/evote-shell evoteadmin
passwd -l evoteadmin
echo 'evoteadmin ALL=(root) NOPASSWD: /usr/local/bin/evote' > /etc/sudoers.d/evoteadmin
chmod 440 /etc/sudoers.d/evoteadmin
mkdir -p /var/lib/evote/receipts /etc/evote
chmod 700 /var/lib/evote/receipts
systemctl enable evote-agent.service cups.service
systemctl enable getty@tty2.service
for n in 3 4 5 6; do systemctl mask "getty@tty${n}.service" "autovt@tty${n}.service"; done
chmod 755 /usr/local/bin/evote /usr/local/bin/evote-shell /usr/local/lib/evote/evote-agent.py
chmod 644 /etc/systemd/system/evote-agent.service /usr/local/lib/evote/setup.html
systemctl mask ctrl-alt-del.target getty@tty1.service autovt@tty1.service
systemctl mask ssh.service sshd.service 2>/dev/null || true
echo "evote-booth" > /etc/hostname
# rebuild the boot ramdisk so it can read exFAT / NTFS / FAT sticks (Ventoy, loopback boots)
update-initramfs -u -k all
