#!/bin/sh
# live-build configuration for "Campus E-Voting Booth OS" (Debian 12 based, BIOS + UEFI hybrid ISO).
# The portal address is NOT fixed here: the kernel command line carries a placeholder that
# booth-os/embed-url.py replaces inside the downloaded ISO (see docs/BOOTH_OS.md).
set -e

# Must match PLACEHOLDER in embed-url.py: "@EVOTEURL@" followed by 190 "x".
PLACEHOLDER="@EVOTEURL@$(printf 'x%.0s' $(seq 1 190))"

lb config noauto \
	--distribution bookworm \
	--architectures amd64 \
	--archive-areas "main contrib non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "syslinux,grub-efi" \
	--debian-installer none \
	--apt-recommends false \
	--apt-indices false \
	--firmware-chroot true \
	--iso-application "Campus E-Voting Booth OS" \
	--iso-publisher "Campus E-Voting" \
	--iso-volume "EVOTE-BOOTH" \
	--image-name "evote-booth-os" \
	--bootappend-live "boot=live components noautologin quiet loglevel=3 evote.url=${PLACEHOLDER}" \
	"${@}"
