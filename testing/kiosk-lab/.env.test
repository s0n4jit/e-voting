# ==============================================================================
# Campus E-Voting System (CEVS) - Windows Kiosk Testing Lab Environment (.env.test)
# Completely isolated from production / local dev databases and services.
# ==============================================================================

# Application Environment
FLASK_ENV=development
DEBUG=True
TESTING=False
LOG_LEVEL=INFO

# Test Database Credentials (PostgreSQL 15 - Isolated)
TEST_DB_NAME=evoting_test_db
TEST_DB_USER=evoting_test_user
TEST_DB_PASSWORD=test_db_secret_pass_2026
TEST_DB_HOST=kiosk_test_db
TEST_DB_PORT=5432
TEST_DB_EXPOSED_PORT=5433
DATABASE_URL=postgresql://evoting_test_user:test_db_secret_pass_2026@kiosk_test_db:5432/evoting_test_db

# Security & Tokens
SECRET_KEY=kiosk-lab-security-session-secret-key-2026-isolated
JWT_SECRET_KEY=kiosk-lab-jwt-signing-secret-key-2026-isolated
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Host Port Mappings (Windows Host -> Docker Containers)
HOST_DB_PORT=5433
HOST_BACKEND_PORT=5001
HOST_FRONTEND_PORT=3001
HOST_NOVNC_PORT=8080
HOST_NET_SIM_PORT=8090

# Kiosk & Polling Station Configuration
BOOTH_ID=BOOTH-LAB-01
VOTING_APP_URL=http://kiosk_test_frontend/kiosk
DEFAULT_KIOSK_TOKEN=booth-standalone-token

# Staff Maintenance Security PIN (Default: 948201)
STAFF_MAINTENANCE_PIN_HASH=scrypt:32768:8:1$$xnWbTNWX6Sm4euD0$$f37b88d47c52160b673a4cc9bcd75ef494e71bca551131001230d1129843032cd319c45f87b9bd98b22a81e4978f9630ca28b58f37bd026bf9b3c46a6284d281
MAINTENANCE_MAX_ATTEMPTS=5
MAINTENANCE_LOCKOUT_SECONDS=900

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://localhost:8080,http://kiosk_test_frontend

# Rate Limiting
RATELIMIT_ENABLED=False
RATELIMIT_DEFAULT=1000 per hour
RATELIMIT_STORAGE_URL=memory://

# OTP & Mail
OTP_SECRET_LENGTH=32
OTP_VALID_WINDOW=1
OTP_ISSUER=CampusEVotingLab
MAIL_SUPPRESS_SEND=True
