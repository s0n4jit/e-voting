# ─────────────────────────────────────────────
#  Campus e-Voting System — Environment Variables
#  Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── Flask ────────────────────────────────────
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ─────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://evoting_user:evoting_pass@localhost:5432/evoting_db

# SQLite (development fallback — leave DATABASE_URL unset to use SQLite)
# DATABASE_URL=sqlite:///evoting_dev.db

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=another-long-random-secret-for-jwt
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# ── Mail (SMTP) ───────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Campus eVoting <your-email@gmail.com>

# ── OTP ───────────────────────────────────────
OTP_SECRET_LENGTH=32
# Time-step window (number of 30-second windows to allow drift)
OTP_VALID_WINDOW=1
# OTP issuer name shown in authenticator apps
OTP_ISSUER=CampusEVoting

# ── Voting ───────────────────────────────────
# Extra buffer (seconds) allowed after election end_time for in-flight votes
VOTING_WINDOW_BUFFER=30

# ── Rate Limiting ─────────────────────────────
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_LOGIN=10 per minute
RATELIMIT_OTP=5 per minute
RATELIMIT_VOTE=3 per minute

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Admin Seed ───────────────────────────────
ADMIN_STUDENT_ID=ADMIN001
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=Admin@123456

# ── Backup ───────────────────────────────────
BACKUP_DIR=/var/backups/evoting
BACKUP_RETENTION_DAYS=30
