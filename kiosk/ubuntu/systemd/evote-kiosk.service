[Unit]
Description=Campus E-Voting Kiosk Browser Service (CEVS)
Documentation=https://github.com/campus-evoting/cevs
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=MOZ_ENABLE_WAYLAND=1
Environment=GDK_BACKEND=wayland
Environment=XDG_CURRENT_DESKTOP=GNOME
Environment=VOTING_URL=http://localhost:3000/kiosk
ExecStart=/usr/local/bin/kiosk-launcher.sh
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

# Security sandboxing at systemd service level
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/snap/firefox %h/.mozilla %h/.cache /tmp /var/tmp
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=graphical-session.target
