# ==============================================================================
# Campus E-Voting System (CEVS) - Least-Privilege Sudoers Configuration
# Security Rule: Allow ONLY strictly vetted maintenance/diagnostic operations.
# NO GENERIC ALL ACCESS ALLOWED.
# File mode must be 0440.
# ==============================================================================

# User alias or target user
# Allows the evote service account or maintenance operator to inspect service,
# restart network, check link status, or gracefully power cycle the kiosk.

evote ALL=(root) NOPASSWD: \
    /bin/systemctl restart evote-kiosk.service, \
    /bin/systemctl status evote-kiosk.service, \
    /usr/bin/systemctl restart evote-kiosk.service, \
    /usr/bin/systemctl status evote-kiosk.service, \
    /bin/systemctl restart systemd-networkd, \
    /usr/bin/systemctl restart systemd-networkd, \
    /bin/systemctl restart NetworkManager, \
    /usr/bin/systemctl restart NetworkManager, \
    /bin/systemctl reboot, \
    /usr/bin/systemctl reboot, \
    /sbin/reboot, \
    /bin/systemctl poweroff, \
    /usr/bin/systemctl poweroff, \
    /sbin/poweroff, \
    /bin/ip link, \
    /sbin/ip link, \
    /bin/ip addr, \
    /sbin/ip addr, \
    /bin/ping -c * [0-9]*, \
    /usr/bin/ping -c * [0-9]*
