# Copy to .env (never commit it) and fill in every value marked REQUIRED.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Use letters and digits only in the password (it is embedded in a URL).
POSTGRES_DB=evoting
POSTGRES_USER=evoting
POSTGRES_PASSWORD=

# ── Application secrets (REQUIRED) ────────────────────────────────────────────
SECRET_KEY=
JWT_SECRET_KEY=

# ── Web ──────────────────────────────────────────────────────────────────────
# Fixed ports. App (web + API) 8080, landing page 8081, API 5000 (localhost only).
# On a real server set WEB_PORT=80 (or 8080 behind a reverse proxy with HTTPS, docs/DEPLOYMENT.md).
WEB_PORT=8080
SITE_PORT=8081
API_PORT=5000
# Origins allowed to call the API from a browser. Only needed when the frontend is hosted on a
# different origin than the API; comma-separated.
CORS_ORIGINS=http://localhost

# Number of reverse proxies in front of the bundled web container (0 if none can be trusted).
# 1 = only the bundled nginx; use 2 if you also put Caddy/nginx/a load balancer in front of it.
PROXY_HOPS=1

# ── Installation wizard ──────────────────────────────────────────────────────
# Optional. If set, whoever runs the first-time setup must enter this token.
SETUP_TOKEN=

